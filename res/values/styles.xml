<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window exists before onCreate returns, so this is the only thing
         the projector can show while the launcher is still building itself.
         Without it the first frame is the platform's default (light) window,
         which on a projector reads as a white flash and a slow start.

         The parent is the material dark theme so the dialogs and the status
         bar keep the same ground as the launcher. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Keep the system's own preview: it is the frame that shows the
             launch drawable immediately after the tap, before our process
             finishes loading. -->
        <item name="android:windowDisablePreview">false</item>
    </style>

</resources>
